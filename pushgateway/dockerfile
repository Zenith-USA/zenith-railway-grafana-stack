ARG VERSION=latest

FROM prom/pushgateway:${VERSION}

# Celery workers can't be scraped, so they push here and Prometheus scrapes this.
# Persistence matters: without it a restart zeroes every pushed counter, which
# reads downstream as a false drop in rate() queries.
# :9091 binds all interfaces — Railway private networking is IPv6-only.
CMD ["--web.listen-address=:9091", "--persistence.file=/data/pushgateway.data", "--persistence.interval=5m"]
