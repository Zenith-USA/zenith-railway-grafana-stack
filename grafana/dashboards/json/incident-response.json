      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafana_prometheus"
          },
          "expr": "sum by (table) (zenith_raw_rows_by_state{status=\"failed\"})",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Recent Ingestion Errors",
      "datasource": {
        "type": "loki",
        "uid": "grafana_lokiq"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafana_lokiq"
          },
          "expr": "{platform=~\"worker|api\", level=~\"ERROR|CRITICAL\"} |~ \"ingest|webhook|pipeline|watchdog\""
        }
      ]
    }
  ]
}
